document.addEventListener("DOMContentLoaded", function () {

    // ==============================
    // ELEMENTS
    // ==============================

    const $ = (id) => document.getElementById(id);

    const zipInput = $("zipInput");
    const zipInfo = $("zipInfo");
    const zipConvert = $("zipConvert");
    const zipStatus = $("zipStatus");
    const zipDownload = $("zipDownload");

    const pdfInput = $("pdfInput");
    const pdfInfo = $("pdfInfo");
    const analyzeBtn = $("analyzeBtn");
    const organizerStatus = $("organizerStatus");

    const autoPanel = $("autoPanel");
    const manualPanel = $("manualPanel");
    const autoList = $("autoList");
    const manualList = $("manualList");

    const recreateAuto = $("recreateAuto");
    const recreateManual = $("recreateManual");
    const organizerDownload = $("organizerDownload");

    let zipFile = null;
    let pdfFile = null;
    let pdfBytes = null;

    let pageData = [];
    let autoOrder = [];
    let manualOrder = [];

    let mode = "auto";
    let generatedPDFBlob = null;


    // ==============================
    // HELPER FUNCTIONS
    // ==============================

    function message(element, text, type = "") {
        if (!element) return;

        element.textContent = text;
        element.className = "status " + type;
    }


    function delay(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }


    function getSize(bytes) {
        if (bytes < 1024 * 1024) {
            return (bytes / 1024).toFixed(1) + " KB";
        }

        return (bytes / 1024 / 1024).toFixed(2) + " MB";
    }


    function extension(name) {
        const pos = name.lastIndexOf(".");

        if (pos === -1) return "";

        return name.substring(pos + 1).toLowerCase();
    }


    function escapeHTML(text) {
        return String(text).replace(/[&<>"']/g, function (c) {
            return {
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                '"': "&quot;",
                "'": "&#39;"
            }[c];
        });
    }


    // ==============================
    // TAB SWITCHING
    // ==============================

    document.querySelectorAll(".tab").forEach(function (button) {

        button.addEventListener("click", function () {

            document.querySelectorAll(".tab").forEach(function (tab) {
                tab.classList.remove("active");
            });

            document.querySelectorAll(".page").forEach(function (page) {
                page.classList.remove("active");
            });

            button.classList.add("active");

            const target = $(button.dataset.page);

            if (target) {
                target.classList.add("active");
            }

        });

    });


    // ==============================
    // AUTOMATIC / MANUAL MODE
    // ==============================

    document.querySelectorAll(".mode").forEach(function (button) {

        button.addEventListener("click", function () {

            document.querySelectorAll(".mode").forEach(function (b) {
                b.classList.remove("active");
            });

            button.classList.add("active");

            mode = button.dataset.mode;

            if (pageData.length === 0) return;

            if (mode === "auto") {
                autoPanel.classList.remove("hidden");
                manualPanel.classList.add("hidden");
            } else {
                autoPanel.classList.add("hidden");
                manualPanel.classList.remove("hidden");
            }

        });

    });


    // ==================================================
    // ZIP FILE SELECTION
    // ==================================================

    if (zipInput) {

        zipInput.addEventListener("change", function () {

            zipFile = zipInput.files[0];

            if (!zipFile) {
                zipInfo.textContent = "No ZIP selected.";
                zipConvert.disabled = true;
                return;
            }

            if (!zipFile.name.toLowerCase().endsWith(".zip")) {

                zipFile = null;
                zipConvert.disabled = true;

                zipInfo.textContent =
                    "Please select a .zip file.";

                message(
                    zipStatus,
                    "Only ZIP files are supported.",
                    "err"
                );

                return;
            }

            zipInfo.textContent =
                zipFile.name + " — " + getSize(zipFile.size);

            zipConvert.disabled = false;

            zipDownload.classList.add("hidden");

            message(
                zipStatus,
                "ZIP selected. Tap Convert ZIP to PDF.",
                "ok"
            );

        });

    }


    // ==================================================
    // ZIP → PDF
    // ==================================================

    if (zipConvert) {

        zipConvert.addEventListener("click", async function () {

            if (!zipFile) return;

            zipConvert.disabled = true;

            try {

                message(
                    zipStatus,
                    "⏳ Reading ZIP file..."
                );

                const zip =
                    await JSZip.loadAsync(zipFile);

                const files =
                    Object.values(zip.files)
                        .filter(function (file) {
                            return !file.dir &&
                                !file.name.startsWith("__MACOSX/");
                        })
                        .sort(function (a, b) {
                            return a.name.localeCompare(
                                b.name,
                                undefined,
                                {
                                    numeric: true,
                                    sensitivity: "base"
                                }
                            );
                        });


                const output =
                    await PDFLib.PDFDocument.create();

                let converted = 0;
                let skipped = 0;


                for (let i = 0; i < files.length; i++) {

                    const file = files[i];
                    const ext = extension(file.name);

                    message(
                        zipStatus,
                        `⏳ Processing ${i + 1}/${files.length}`
                    );

                    try {

                        // PDF
                        if (ext === "pdf") {

                            const bytes =
                                await file.async("uint8array");

                            const source =
                                await PDFLib.PDFDocument.load(bytes);

                            const pages =
                                await output.copyPages(
                                    source,
                                    source.getPageIndices()
                                );

                            pages.forEach(function (page) {
                                output.addPage(page);
                            });

                            converted++;
                        }

                        // IMAGE
                        else if (
                            ext === "jpg" ||
                            ext === "jpeg" ||
                            ext === "png"
                        ) {

                            const bytes =
                                await file.async("uint8array");

                            let image;

                            if (ext === "png") {
                                image =
                                    await output.embedPng(bytes);
                            } else {
                                image =
                                    await output.embedJpg(bytes);
                            }


                            // A4
                            const pageWidth = 595.28;
                            const pageHeight = 841.89;

                            const margin = 20;

                            const maxWidth =
                                pageWidth - margin * 2;

                            const maxHeight =
                                pageHeight - margin * 2;

                            const scale =
                                Math.min(
                                    maxWidth / image.width,
                                    maxHeight / image.height
                                );

                            const width =
                                image.width * scale;

                            const height =
                                image.height * scale;

                            const page =
                                output.addPage([
                                    pageWidth,
                                    pageHeight
                                ]);

                            page.drawImage(image, {
                                x: (pageWidth - width) / 2,
                                y: (pageHeight - height) / 2,
                                width: width,
                                height: height
                            });

                            converted++;

                        } else {

                            skipped++;

                        }

                    } catch (error) {

                        console.error(
                            "Skipped:",
                            file.name,
                            error
                        );

                        skipped++;
                    }

                    await delay(1);
                }


                if (output.getPageCount() === 0) {
                    throw new Error(
                        "No PDF, JPG or PNG files found inside the ZIP."
                    );
                }


                message(
                    zipStatus,
                    "⏳ Creating final PDF..."
                );

                const bytes =
                    await output.save();

                const blob =
                    new Blob(
                        [bytes],
                        {
                            type: "application/pdf"
                        }
                    );

                const url =
                    URL.createObjectURL(blob);


                zipDownload.href = url;
                zipDownload.download = "converted-files.pdf";

                zipDownload.textContent =
                    "⬇️ Download PDF";

                zipDownload.classList.remove("hidden");


                message(
                    zipStatus,
                    `✅ PDF created! ${converted} file(s) converted.`,
                    "ok"
                );

            } catch (error) {

                console.error(error);

                message(
                    zipStatus,
                    "❌ Conversion failed: " +
                    error.message,
                    "err"
                );

            } finally {

                zipConvert.disabled = false;
            }

        });

    }


    // ==================================================
    // PDF SELECTION
    // ==================================================

    if (pdfInput) {

        pdfInput.addEventListener("change", function () {

            pdfFile = pdfInput.files[0];

            pageData = [];
            autoOrder = [];
            manualOrder = [];

            autoPanel.classList.add("hidden");
            manualPanel.classList.add("hidden");

            organizerDownload.classList.add("hidden");

            recreateAuto.disabled = true;
            recreateManual.disabled = true;

            if (!pdfFile) {

                pdfInfo.textContent =
                    "No PDF selected.";

                analyzeBtn.disabled = true;

                return;
            }


            if (
                !pdfFile.name
                    .toLowerCase()
                    .endsWith(".pdf")
            ) {

                pdfFile = null;

                pdfInfo.textContent =
                    "Please select a PDF.";

                analyzeBtn.disabled = true;

                message(
                    organizerStatus,
                    "Only PDF files are supported.",
                    "err"
                );

                return;
            }


            pdfInfo.textContent =
                pdfFile.name +
                " — " +
                getSize(pdfFile.size);

            analyzeBtn.disabled = false;

            message(
                organizerStatus,
                "PDF selected. Tap Analyze PDF.",
                "ok"
            );

        });

    }


    // ==================================================
    // ANALYZE PDF
    // ==================================================

    if (analyzeBtn) {

        analyzeBtn.addEventListener("click", async function () {

            if (!pdfFile) return;

            analyzeBtn.disabled = true;

            try {

                message(
                    organizerStatus,
                    "⏳ Loading PDF..."
                );

                pdfBytes =
                    new Uint8Array(
                        await pdfFile.arrayBuffer()
                    );


                if (!window.pdfjsLib) {
                    throw new Error(
                        "PDF reader is not loaded. Refresh the page and try again."
                    );
                }


                const pdf =
                    await pdfjsLib.getDocument({
                        data: pdfBytes
                    }).promise;


                pageData = [];


                for (
                    let page = 1;
                    page <= pdf.numPages;
                    page++
                ) {

                    const pdfPage =
                        await pdf.getPage(page);

                    const content =
                        await pdfPage.getTextContent();

                    const text =
                        content.items
                            .map(item => item.str)
                            .join(" ");


                    pageData.push({
                        page: page,
                        text: text
                    });


                    if (
                        page % 5 === 0 ||
                        page === pdf.numPages
                    ) {

                        message(
                            organizerStatus,
                            `⏳ Reading page ${page}/${pdf.numPages}`
                        );

                        await delay(1);
                    }
                }


                // AUTOMATIC ORDER
                autoOrder =
                    pageData
                        .map(function (item, index) {

                            const topic =
                                findTopicNumber(item.text);

                            return {
                                index: index,
                                number: topic.number,
                                priority: topic.priority,
                                original: index
                            };

                        })
                        .sort(function (a, b) {

                            if (a.number !== b.number) {
                                return a.number - b.number;
                            }

                            if (a.priority !== b.priority) {
                                return a.priority - b.priority;
                            }

                            return a.original - b.original;

                        })
                        .map(item => item.index);


                // MANUAL ORDER
                manualOrder =
                    pageData.map(
                        (_, index) => index
                    );


                renderAuto();
                renderManual();


                if (mode === "auto") {

                    autoPanel.classList.remove("hidden");
                    manualPanel.classList.add("hidden");

                } else {

                    autoPanel.classList.add("hidden");
                    manualPanel.classList.remove("hidden");
                }


                recreateAuto.disabled = false;
                recreateManual.disabled = false;


                message(
                    organizerStatus,
                    `✅ ${pageData.length} pages analyzed. Review the order.`,
                    "ok"
                );

            } catch (error) {

                console.error(error);

                message(
                    organizerStatus,
                    "❌ Could not analyze PDF: " +
                    error.message,
                    "err"
                );

            } finally {

                analyzeBtn.disabled = false;
            }

        });

    }


    // ==================================================
    // FIND TOPIC NUMBER
    // ==================================================

    function findTopicNumber(text) {

        const clean =
            text
                .replace(/\s+/g, " ")
                .trim();


        // Chapter 1
        // Topic 2
        // Unit 3
        // Lesson 4
        const match =
            clean.match(
                /(?:chapter|ch\.?|topic|unit|lesson|section|part)\s*[-.:]?\s*(\d{1,3})/i
            );


        if (match) {

            return {
                number: parseInt(match[1]),
                priority: 0
            };
        }


        // 1. Introduction
        // 2) History
        const beginning =
            clean.match(
                /^\s*(\d{1,3})\s*[.)\-:]\s+/
            );


        if (beginning) {

            return {
                number: parseInt(beginning[1]),
                priority: 1
            };
        }


        return {
            number: 999999,
            priority: 999
        };
    }


    // ==================================================
    // PAGE TITLE
    // ==================================================

    function pageTitle(data) {

        let text =
            data.text
                .replace(/\s+/g, " ")
                .trim();


        if (!text) {
            return "Page " + data.page;
        }


        if (text.length > 90) {
            text =
                text.substring(0, 90) + "…";
        }


        return text;
    }


    // ==================================================
    // RENDER AUTOMATIC
    // ==================================================

    function renderAuto() {

        autoList.innerHTML = "";


        autoOrder.forEach(function (index, position) {

            const data =
                pageData[index];


            const item =
                document.createElement("div");

            item.className = "item";


            item.innerHTML = `
                <div class="item-main">
                    <div class="item-title">
                        ${position + 1}.
                        ${escapeHTML(pageTitle(data))}
                    </div>

                    <div class="item-meta">
                        Original page ${data.page}
                    </div>
                </div>
            `;


            autoList.appendChild(item);
        });
    }


    // ==================================================
    // RENDER MANUAL
    // ==================================================

    function renderManual() {

        manualList.innerHTML = "";


        manualOrder.forEach(function (index, position) {

            const data =
                pageData[index];


            const item =
                document.createElement("div");

            item.className = "item";


 
